{
  "expo": {
    "name": "TAYZEN",
    "slug": "fixy-app",
    "version": "1.0.0",
    "scheme": [
      "tayzen",
      "fixy-app"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TAYZEN dùng vị trí để KTV tìm đến địa chỉ của bạn, xác nhận đã đến nơi và gửi vị trí khi bạn bấm SOS.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "TAYZEN dùng camera để chụp CCCD, ảnh đại diện và ảnh hoàn thành dịch vụ.",
          "photosPermission": "TAYZEN cần truy cập ảnh để bạn tải ảnh đại diện, CCCD và chứng chỉ.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.tayzen.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B4824"
      },
      "package": "vn.tayzen.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "vietnamProvincesApiUrl": "https://provinces.open-api.vn/api/v2",
      "router": {},
      "eas": {
        "projectId": "901f1bec-4b1c-4717-8dd5-2c1b13bdc6f3"
      }
    }
  }
}
